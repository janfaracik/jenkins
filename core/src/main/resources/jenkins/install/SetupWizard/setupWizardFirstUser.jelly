<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">

  <l:layout type="full-screen" title="${it.displayName}">
    <l:main-panel>
     <link rel="stylesheet" href="${resURL}/jsbundles/pluginSetupWizard.css" type="text/css" />
     <div class="create-admin-user app-setup-wizard-frame">
       <form action="${rootURL}/setupWizard/createAdminUser" method="post">
          <local:_entryForm it="${app.securityRealm}" host="${app.securityRealm}" xmlns:local="/hudson/security/HudsonPrivateSecurityRealm" />
       </form>
     </div>
    </l:main-panel>
  </l:layout>

</j:jelly>
