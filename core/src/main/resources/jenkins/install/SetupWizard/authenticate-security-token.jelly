<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:s="/lib/form">

  <l:layout type="full-screen" title="${%authenticate-security-token.unlock.jenkins}">
    <l:main-panel>
      <st:include page="client-scripts" />
      <form action="${app.instance.securityRealm.authenticationGatewayUrl}" method="POST">
        <input type="hidden" name="from" value="${request2.getParameter('from')}" />
        <input type="hidden" name="${h.getCrumbRequestField()}" value="${h.getCrumb(request2)}"/>
        <div class="app-setup-wizard">
          <div class="app-setup-wizard__dialog">
            <div class="app-setup-wizard__body app-setup-wizard__body--unlock">
              <div class="app-setup-wizard__unlock">
                <l:app-bar title="${%authenticate-security-token.unlock.jenkins}">
                  <a href="https://www.jenkins.io/redirect/find-jenkins-logs" target="_blank" rel="noopener noreferrer" class="jenkins-button" title="${%authenticate-security-token.help}" aria-label="${%authenticate-security-token.help}">
                    <l:icon src="symbol-help-circle" />
                  </a>
                </l:app-bar>
                <p class="app-setup-wizard__lead">${%jenkins.install.findSecurityTokenMessage(it.initialAdminPasswordFile)}</p>
                <j:if test="${error}">
                  <div class="jenkins-alert jenkins-alert-danger">
                    <strong>${%authenticate-security-token.error}</strong> ${%authenticate-security-token.password.incorrect}
                  </div>
                </j:if>
                <div class="jenkins-form-item">
                  <label class="jenkins-form-label" for="security-token">${%authenticate-security-token.password.administrator}</label>
                  <input name="j_username" value="${app.setupWizard.initialSetupAdminUserName}" type="hidden"/>
                  <input id="security-token" class="jenkins-input ${error ? 'jenkins-input--error' : ''}" type="password" name="j_password"/>
                </div>
                <button type="submit" class="jenkins-button jenkins-button--primary app-setup-wizard__unlock-submit set-security-key">${%authenticate-security-token.continue}</button>
              </div>
            </div>
          </div>
          <div class="app-setup-wizard__version">Jenkins ${h.version}</div>
        </div>
      </form>
    </l:main-panel>
  </l:layout>

</j:jelly>
