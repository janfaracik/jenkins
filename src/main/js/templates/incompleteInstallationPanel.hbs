<div class="app-setup-wizard__body app-setup-wizard__body--narrow">
  <div class="app-setup-wizard__narrow">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{translations.installWizard_installIncomplete_banner}}</h1>
      </div>
    </div>
    <p class="app-setup-wizard__narrow-text">{{translations.installWizard_installIncomplete_message}}</p>
    {{> installList}}
    <div class="app-setup-wizard__narrow-buttons">
      <button type="button" class="jenkins-button jenkins-button--primary resume-installation">{{translations.installWizard_installIncomplete_resumeInstallationButtonLabel}}</button>
      <button type="button" class="jenkins-button install-home">{{translations.installWizard_goBack}}</button>
    </div>
  </div>
</div>
