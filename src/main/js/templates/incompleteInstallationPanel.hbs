<div class="app-setup-wizard__body app-setup-wizard__body--installing">
  <div class="app-setup-wizard__hero app-setup-wizard__hero--compact">
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_installIncomplete_banner}}</h1>
    <p class="app-setup-wizard__lead">{{translations.installWizard_installIncomplete_message}}</p>
  </div>
  <div class="app-setup-wizard__plugins app-setup-wizard__plugins--full">
    {{#each installingPlugins}}
    <div class="app-setup-wizard__plugin app-setup-wizard__plugin--{{installStatus}}" data-name="{{id name}}">{{title}}</div>
    {{/each}}
  </div>
</div>
<div class="app-setup-wizard__footer">
  <button type="button" class="jenkins-button jenkins-button--primary resume-installation">{{translations.installWizard_installIncomplete_resumeInstallationButtonLabel}}</button>
  <button type="button" class="jenkins-button jenkins-button--tertiary install-home">{{translations.installWizard_goBack}}</button>
</div>
