<div class="app-setup-wizard__header">
  <h2 class="app-setup-wizard__title">{{translations.installWizard_installComplete_title}}</h2>
</div>
<div class="app-setup-wizard__body">
  <div class="app-setup-wizard__hero">
    {{#if restartRequired}}
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_installComplete_bannerRestart}}</h1>
    {{else}}
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_installComplete_banner}}</h1>
    {{/if}}
    {{#if message}}<div class="app-setup-wizard__message">{{{message}}}</div>{{/if}}
    {{#if restartRequired}}
      {{#if restartSupported}}
      <p class="app-setup-wizard__lead">{{translations.installWizard_installComplete_installComplete_restartRequiredMessage}}</p>
      <button type="button" class="jenkins-button jenkins-button--primary install-done-restart">{{translations.installWizard_installComplete_restartLabel}}</button>
      {{else}}
      <p class="app-setup-wizard__lead">{{translations.installWizard_installComplete_installComplete_restartRequiredNotSupportedMessage}}</p>
      {{/if}}
    {{else}}
    <p class="app-setup-wizard__lead">{{translations.installWizard_installComplete_message}}</p>
    <button type="button" class="jenkins-button jenkins-button--primary install-done">{{translations.installWizard_installComplete_finishButtonLabel}}</button>
    {{/if}}
  </div>
</div>
