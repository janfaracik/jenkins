{{#each categorizedPlugins}}
<h3 id="{{id @key}}" class="jenkins-side-nav__heading app-setup-wizard__picker-category">{{@key}}</h3>
<div class="app-setup-wizard__picker-items">
  {{#each this}}
  <div class="app-setup-wizard__picker-item {{#inSelectedPlugins plugin.name}}app-setup-wizard__picker-item--selected{{/inSelectedPlugins}}" id="row-{{id plugin.name}}">
    <div class="app-setup-wizard__picker-item-header">
      <span class="jenkins-checkbox">
        <input type="checkbox" id="chk-{{id plugin.name}}" name="{{plugin.name}}" {{#inSelectedPlugins plugin.name}}checked="checked"{{/inSelectedPlugins}}/>
        <label for="chk-{{id plugin.name}}" class="app-setup-wizard__picker-name">{{plugin.title}}</label>
      </span>
      <a href="{{plugin.website}}" target="_blank" class="app-setup-wizard__picker-website" rel="noopener noreferrer" title="{{plugin.title}} {{../../translations.installWizard_websiteLinkLabel}}"></a>
      {{#if plugin.suggested}}
      <span class="jenkins-badge jenkins-!-color-purple">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" viewBox="0 0 512 512"><path d="M480 208H308L256 48l-52 160H32l140 96-54 160 138-100 138 100-54-160z" fill="currentColor" stroke="currentColor" stroke-linejoin="round" stroke-width="32"/></svg>
        {{@root.translations.installWizard_installCustom_selectRecommended}}
      </span>
      {{/if}}
    </div>
    <div class="jenkins-checkbox__description app-setup-wizard__picker-description">{{{plugin.excerpt}}}</div>
  </div>
  {{/each}}
</div>
{{/each}}
