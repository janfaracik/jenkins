<div class="app-setup-wizard__body app-setup-wizard__body--narrow">
  <div class="app-setup-wizard__narrow" id="error-message">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{translations.installWizard_error_header}}</h1>
      </div>
    </div>
    <p class="app-setup-wizard__narrow-text">{{errorMessage}}</p>
    <div class="app-setup-wizard__narrow-buttons">
      <button type="button" class="jenkins-button jenkins-button--primary start-over">{{translations.installWizard_retry}}</button>
    </div>
  </div>
</div>
