<div class="app-setup-wizard__header">
  <h2 class="app-setup-wizard__title">{{translations.installWizard_error_title}}</h2>
</div>
<div class="app-setup-wizard__body">
  <div class="app-setup-wizard__hero" id="error-message">
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_error_header}}</h1>
    <div class="jenkins-alert jenkins-alert-danger">{{errorMessage}}</div>
  </div>
</div>
<div class="app-setup-wizard__footer">
  <button type="button" class="jenkins-button jenkins-button--primary start-over">{{translations.installWizard_retry}}</button>
</div>
