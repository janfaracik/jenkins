<div class="app-setup-wizard__body app-setup-wizard__body--frame">
  {{#if message}}<div class="app-setup-wizard__message">{{{message}}}</div>{{/if}}
  <iframe class="app-setup-wizard__frame" src="{{baseUrl}}/setupWizard/setupWizardConfigureInstance" id="setup-configure-instance"></iframe>
</div>
<div class="app-setup-wizard__footer">
  <button type="button" class="jenkins-button jenkins-button--tertiary skip-configure-instance" disabled>{{translations.installWizard_skipConfigureInstance}}</button>
  <button type="button" class="jenkins-button jenkins-button--primary save-configure-instance" disabled>{{translations.installWizard_saveConfigureInstance}}</button>
</div>
