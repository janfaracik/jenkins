<div class="app-setup-wizard__body app-setup-wizard__body--narrow">
  <div class="app-setup-wizard__narrow">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{translations.installWizard_configureInstance_title}}</h1>
      </div>
    </div>
    {{#if message}}<div>{{{message}}}</div>{{/if}}
    <iframe class="app-setup-wizard__frame" src="{{baseUrl}}/setupWizard/setupWizardConfigureInstance" id="setup-configure-instance"></iframe>
    <div class="app-setup-wizard__narrow-buttons">
      <button type="button" class="jenkins-button jenkins-button--primary save-configure-instance" disabled>{{translations.installWizard_saveConfigureInstance}}</button>
      <button type="button" class="jenkins-button skip-configure-instance" disabled>{{translations.installWizard_skipConfigureInstance}}</button>
    </div>
  </div>
</div>
