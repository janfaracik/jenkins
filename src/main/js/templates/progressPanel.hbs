<div class="app-setup-wizard__body app-setup-wizard__body--installing">
  <div class="app-setup-wizard__install-header">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{title}}</h1>
      </div>
      <div class="jenkins-app-bar__controls">
        <span class="app-setup-wizard__install-count"></span>
      </div>
    </div>
    <span class="app-progress-bar app-setup-wizard__progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="{{title}}">
      <span style="width: 0%;"></span>
    </span>
  </div>
  <div class="app-setup-wizard__install-list">
    {{> installList}}
  </div>
</div>
