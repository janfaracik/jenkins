<div class="app-setup-wizard__header app-setup-wizard__header--closeable">
  <h2 class="app-setup-wizard__title">{{translations.installWizard_welcomePanel_title}}</h2>
</div>
<div class="app-setup-wizard__body">
  <div class="app-setup-wizard__hero">
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_welcomePanel_banner}}</h1>
    <p class="app-setup-wizard__lead">{{translations.installWizard_welcomePanel_message}}</p>
  </div>
  <div class="app-setup-wizard__choices">
    <a class="app-setup-wizard__choice app-setup-wizard__choice--primary install-recommended" href="#" role="button">
      <span class="app-setup-wizard__choice-title">{{translations.installWizard_welcomePanel_recommendedActionTitle}}</span>
      <span class="app-setup-wizard__choice-description">{{translations.installWizard_welcomePanel_recommendedActionDetails}}</span>
    </a>
    <a class="app-setup-wizard__choice install-custom" href="#" role="button">
      <span class="app-setup-wizard__choice-title">{{translations.installWizard_welcomePanel_customizeActionTitle}}</span>
      <span class="app-setup-wizard__choice-description">{{translations.installWizard_welcomePanel_customizeActionDetails}}</span>
    </a>
  </div>
</div>
