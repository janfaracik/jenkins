<div class="app-setup-wizard__body app-setup-wizard__body--picker">
  <nav class="app-setup-wizard__categories">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{translations.installWizard_installCustom_pluginsTitle}}</h1>
      </div>
    </div>
    <p class="jenkins-side-nav__heading">{{translations.installWizard_installCustom_categoriesTitle}}</p>
    <div class="tasks">
      {{#each categories}}
      <div class="task app-setup-wizard__category">
        <a href="#{{id this}}" class="task-link select-category">
          <span class="task-icon-link">{{{category-icon this}}}</span>
          <span class="task-link-text">{{this}}</span>
        </a>
      </div>
      {{/each}}
    </div>
    <p class="app-setup-wizard__categories-note">{{additionalPluginsNote}}</p>
  </nav>
  <div class="app-setup-wizard__picker">
    <div class="app-setup-wizard__picker-list">
      <div class="jenkins-app-bar jenkins-app-bar--sticky">
        <div class="jenkins-app-bar__content">
          <div class="jenkins-search-container">
            <div class="jenkins-search jenkins-search--app-bar">
              <div class="jenkins-search__icon">
                <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" viewBox="0 0 512 512"><path d="M221.09 64a157.09 157.09 0 10157.09 157.09A157.1 157.1 0 00221.09 64z" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="32"/><path d="M338.29 338.29L448 448" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="32"/></svg>
              </div>
              <input type="search" name="searchbox" class="jenkins-input jenkins-search__input app-setup-wizard__search-input" placeholder="{{translations.installWizard_installCustom_search}}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
            </div>
          </div>
        </div>
        <div class="jenkins-app-bar__controls">
          <a href="https://www.jenkins.io/redirect/installation-wizard" target="_blank" rel="noopener noreferrer" class="jenkins-button" title="{{translations.installWizard_installCustom_help}}" aria-label="{{translations.installWizard_installCustom_help}}">
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" viewBox="0 0 512 512"><path d="M256 40a216 216 0 10216 216A216 216 0 00256 40z" fill="none" stroke="currentColor" stroke-miterlimit="10" stroke-width="38"/><path d="M200 202.29s.84-17.5 19.57-32.57C230.68 160.77 244 158.18 256 158c10.93-.14 20.69 1.67 26.53 4.45 10 4.76 29.47 16.38 29.47 41.09 0 26-17 37.81-36.37 50.8S251 281.43 251 296" fill="none" stroke="currentColor" stroke-linecap="round" stroke-miterlimit="10" stroke-width="38"/><circle cx="250" cy="360" r="25" fill="currentColor"/></svg>
          </a>
        </div>
      </div>
      {{> pluginSelectList}}
      <div class="jenkins-bottom-app-bar__shadow jenkins-bottom-app-bar__shadow--borderless"></div>
      <div class="bottom-sticker">
        <div class="bottom-sticker-inner jenkins-buttons-row">
          <button type="button" class="jenkins-button jenkins-button--primary install-selected">{{installLabel}}</button>
          <button type="button" class="jenkins-button skip-plugin-installs {{#unless hasSelection}}jenkins-hidden{{/unless}}">{{translations.installWizard_installCustom_skip}}</button>
          <span id="plugin-selected-info" class="app-setup-wizard__selected-info">{{selectedCount}}</span>
        </div>
      </div>
    </div>
  </div>
</div>
