<div class="app-setup-wizard__body app-setup-wizard__body--narrow">
  <div class="app-setup-wizard__narrow">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{title}}</h1>
      </div>
    </div>
    <iframe class="app-setup-wizard__frame app-setup-wizard__frame--fit" src="{{baseUrl}}/setupWizard/setupWizardFirstUser" id="setup-first-user"></iframe>
    <div class="app-setup-wizard__narrow-buttons">
      <button type="button" class="jenkins-button jenkins-button--primary save-first-user" disabled>{{translations.installWizard_saveFirstUser}}</button>
      <button type="button" class="jenkins-button skip-first-user" disabled>{{translations.installWizard_skipFirstUser}}</button>
    </div>
  </div>
</div>
