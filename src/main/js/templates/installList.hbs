<ol class="app-setup-wizard__install-items">
  {{#each installingPlugins}}
  <li class="app-setup-wizard__install-item app-setup-wizard__install-item--{{installStatus}}">
    <span class="app-setup-wizard__install-icon"></span>
    <div>
      <div class="app-setup-wizard__install-name">{{title}}</div>
      <div class="app-setup-wizard__install-error">{{errorMessage}}</div>
    </div>
  </li>
  {{/each}}
</ol>
