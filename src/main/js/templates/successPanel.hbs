<div class="app-setup-wizard__body app-setup-wizard__body--narrow">
  <div class="app-setup-wizard__narrow">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{translations.installWizard_pluginInstallFailure_title}}</h1>
      </div>
    </div>
    <p class="app-setup-wizard__narrow-text">{{translations.installWizard_pluginInstallFailure_message}}</p>
    {{> installList}}
    <div class="app-setup-wizard__narrow-buttons">
      <button type="button" class="jenkins-button jenkins-button--primary retry-failed-plugins">{{translations.installWizard_retry}}</button>
      <button type="button" class="jenkins-button continue-with-failed-plugins">{{translations.installWizard_continue}}</button>
    </div>
  </div>
</div>
