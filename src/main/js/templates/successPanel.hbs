<div class="app-setup-wizard__body app-setup-wizard__body--installing">
  <div class="app-setup-wizard__hero app-setup-wizard__hero--compact">
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_pluginInstallFailure_title}}</h1>
    {{#if failedPlugins}}
    <p class="app-setup-wizard__lead">{{translations.installWizard_pluginInstallFailure_message}}</p>
    {{/if}}
  </div>
  <div class="app-setup-wizard__plugins app-setup-wizard__plugins--full">
    {{#each installingPlugins}}
    <div class="app-setup-wizard__plugin app-setup-wizard__plugin--{{installStatus}}" data-name="{{id name}}">{{title}}</div>
    {{/each}}
  </div>
</div>
<div class="app-setup-wizard__footer">
  {{#if failedPlugins}}
  <button type="button" class="jenkins-button jenkins-button--primary retry-failed-plugins">{{translations.installWizard_retry}}</button>
  <button type="button" class="jenkins-button jenkins-button--tertiary continue-with-failed-plugins">{{translations.installWizard_continue}}</button>
  {{else}}
  <button type="button" class="jenkins-button jenkins-button--primary continue-with-failed-plugins">{{translations.installWizard_continue}}</button>
  {{/if}}
</div>
