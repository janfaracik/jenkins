<div class="app-setup-wizard__body app-setup-wizard__body--narrow">
  <div class="app-setup-wizard__narrow">
    <div class="jenkins-app-bar">
      <div class="jenkins-app-bar__content">
        <h1>{{translations.installWizard_offline_title}}</h1>
      </div>
    </div>
    <p class="app-setup-wizard__narrow-text">{{{translations.installWizard_offline_message}}}</p>
    <div class="app-setup-wizard__narrow-buttons">
      <button type="button" class="jenkins-button jenkins-button--primary show-proxy-config">{{translations.installWizard_configureProxy_label}}</button>
      <button type="button" class="jenkins-button skip-plugin-installs">{{translations.installWizard_skipPluginInstallations}}</button>
    </div>
  </div>
</div>
