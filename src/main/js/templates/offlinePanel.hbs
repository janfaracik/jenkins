<div class="app-setup-wizard__body">
  <div class="app-setup-wizard__hero">
    <h1 class="app-setup-wizard__heading">{{translations.installWizard_offline_title}}</h1>
    <p class="app-setup-wizard__lead">{{{translations.installWizard_offline_message}}}</p>
    <div class="jenkins-buttons-row">
      <button type="button" class="jenkins-button jenkins-button--primary show-proxy-config">{{translations.installWizard_configureProxy_label}}</button>
      <button type="button" class="jenkins-button skip-plugin-installs">{{translations.installWizard_skipPluginInstallations}}</button>
    </div>
  </div>
</div>
